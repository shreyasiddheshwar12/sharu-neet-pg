{
  "name": "NEET PG 2027 Planner",
  "short_name": "NEET PG",
  "description": "Day plan, tracker and mocks for NEET PG 2027. Works offline; progress stays on this device.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0e1b",
